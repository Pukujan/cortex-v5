{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [],
  "provider": {
    "ckff": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "ckff / Cortex cross-vendor seats",
      "options": {
        "baseURL": "{env:LITELLM_URL}",
        "apiKey": "{env:LITELLM_MASTER_KEY}",
        "timeout": 600000,
        "chunkTimeout": 600000
      },
      "models": {
        "grok-4.6": {"name": "grok-4.6"},
        "gpt-5.6-sol": {"name": "gpt-5.6-sol"},
        "kimi-k3": {"name": "kimi-k3"},
        "qwen3.8-max": {"name": "qwen3.8-max"},
        "gemini-3.6-flash": {"name": "gemini-3.6-flash"}
      }
    }
  },
  "permission": {
    "external_directory": "deny",
    "task": "deny",
    "question": "deny",
    "doom_loop": "deny",
    "bash": {
      "*": "ask",
      "git push*": "deny",
      "git commit*": "deny",
      "git reset --hard*": "deny",
      "sudo *": "deny"
    }
  },
  "agent": {
    "plan": {
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "edit": "deny",
        "task": "deny",
        "question": "deny",
        "doom_loop": "deny",
        "external_directory": "deny",
        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow"
        }
      }
    }
  }
}
